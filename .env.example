# Postgres (Neon). Use a URL "pooled" em DATABASE_URL e a conexão direta em DIRECT_URL (migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/devflow?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/devflow?sslmode=require"

# Better Auth — gere com: openssl rand -base64 32
BETTER_AUTH_SECRET="troque-por-uma-string-aleatoria-de-32-caracteres"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Fuso usado para agrupar dias/semanas nos indicadores
APP_TIMEZONE="America/Sao_Paulo"

# Banco usado pelos testes (é apagado a cada execução — nunca aponte para produção)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devflow_test"
